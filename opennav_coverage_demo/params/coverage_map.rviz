Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 50
      Color: 100; 100; 100
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Name: Editable map
      Enabled: true
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Field and obstacles
      Enabled: true
      Topic:
        Value: /coverage_map/field
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Ordered coverage plan
      Enabled: true
      Namespaces:
        coverage_work: true
        coverage_turns: true
        coverage_direction: true
        coverage_swath_numbers: true
        coverage_endpoints: true
        coverage_endpoint_labels: true
        coverage_legend: true
      Topic:
        Value: /coverage_map/plan_markers
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Raw path (optional)
      Enabled: false
      Alpha: 1
      Color: 255; 70; 20
      Line Style: Billboards
      Line Width: 0.06
      Pose Style: None
      Topic:
        Value: /coverage_map/path
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: Raw swaths (optional)
      Enabled: false
      Topic:
        Value: /coverage_server/swaths
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Polygon
      Name: Planning boundary
      Enabled: true
      Color: 255; 200; 0
      Topic:
        Value: /coverage_server/planning_field
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  Global Options:
    Fixed Frame: map
    Background Color: 40; 40; 40
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Scale: 35
      X: 10
      Y: 7
      Angle: 0
Window Geometry:
  Width: 1300
  Height: 850
